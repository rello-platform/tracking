{
  "name": "@rello-platform/tracking",
  "version": "0.6.0",
  "description": "Platform tracking vocabulary for the Rello ecosystem: the 12 event schemas, the FEATURES and ROUTES registries, the page script, and the /t/c redirect.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "comment:exports": "Single-format ESM, the metric-keys/slugs precedent: the same ESM file under import/require/default so a CJS consumer on Node >=22 (require(esm)) cannot hit ERR_PACKAGE_PATH_NOT_EXPORTED. ./script is the built browser file the engine serves at /t/s.v<major>.<minor>.js.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./redirect": {
      "types": "./dist/redirect.d.ts",
      "import": "./dist/redirect.js",
      "require": "./dist/redirect.js",
      "default": "./dist/redirect.js"
    },
    "./script": "./dist/script/s.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc && node scripts/build-script.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && tsc -p tsconfig.test.json --noEmit && vitest run",
    "prepublishOnly": "npm run compile",
    "hooks": "git config core.hooksPath .husky || true"
  },
  "dependencies": {
    "@rello-platform/slugs": "github:rello-platform/slugs#v0.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "github:rello-platform/tracking"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED"
}
